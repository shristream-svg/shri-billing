{
  "name": "shri-billing",
  "version": "1.7.1",
  "private": true,
  "description": "Offline billing for SHRI CYBER CAFE",
  "author": "SHRI CYBER CAFE",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "package": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "in.shricybercafe.billing",
    "productName": "SHRI BILLING",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  }
}

